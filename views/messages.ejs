<body>
    <h1>hello from messages</h1>
    <a href="/new">Add message</a>
    <%let id%>
    <%for( let i=0; i< messages.length;i++){%>
        <%id= i+1%>
        <ul>
            <li><%=messages[i].username%></li>
            <li><%=messages[i].message%></li>
            <li><%=messages[i].posting_date%></li>
        </ul>
        <a href="new/<%=id %>">test me</a>
    <%}%>
</body>
